# Copy this file to .env for local runs, or set these as real environment
# variables in your host's control panel (recommended for Wispbyte).
# Environment variables always override config.json.

# --- Required ---
SERVER_HOST=example.aternos.me
BOT_USERNAME=AFKBot

# --- Connection ---
SERVER_PORT=19132
# Bedrock protocol version to speak. Must match a version bedrock-protocol
# supports (currently 1.16.201 through 1.26.30). Leave as-is unless your
# server reports a different version in disconnect/version-mismatch errors.
BEDROCK_VERSION=1.26.30
# true = offline-style connection, no Microsoft/Xbox Live sign-in.
# This is what most self-hosted/Aternos "cracked" style AFK bot setups need.
AUTH_OFFLINE=true
CONNECT_TIMEOUT_MS=9000
# How many chunks of world data to request from the server. Lower = less
# memory and bandwidth. Bedrock clients commonly go as low as 4.
VIEW_DISTANCE=4
# jsp-raknet (pure JS, default) needs no native compilation and is the most
# portable choice on shared/low-cost hosting. raknet-native is faster but
# requires a C++ build toolchain at install time.
RAKNET_BACKEND=jsp-raknet

# --- Reconnect behavior ---
RECONNECT_ENABLED=true
RECONNECT_BASE_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=300000
# 0 = retry forever. Set a number to give up and exit after N failed
# attempts (useful if you want your host's crash/restart policy to take over).
RECONNECT_MAX_ATTEMPTS=0
RECONNECT_JITTER_MS=1000

# --- Anti-AFK ---
ANTI_AFK_ENABLED=true
# rotate = only changes look direction (safest, default)
# walk   = also nudges position within ANTI_AFK_WALK_RADIUS blocks
# none   = disable simulated movement, rely on presence + chat heartbeat only
ANTI_AFK_MODE=rotate
ANTI_AFK_INTERVAL_MS=15000
ANTI_AFK_WALK_RADIUS=0.5

# --- Optional chat heartbeat (off by default) ---
CHAT_HEARTBEAT_ENABLED=false
CHAT_HEARTBEAT_INTERVAL_MS=600000
CHAT_HEARTBEAT_MESSAGE=AFK bot keep-alive active.

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text

# --- Optional health check HTTP endpoint (off by default) ---
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_PORT=3000
HEALTH_CHECK_PATH=/health

# --- Optional: path to a JSON config file (see config.example.json) ---
# CONFIG_PATH=./config.json
